{
  "name": "hanin-hala-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant POS/KDS system - offline-first for local LAN",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:server": "npm run dev --workspace=@hanin-hala/server",
    "dev:web-waiter": "npm run dev --workspace=@hanin-hala/web-waiter",
    "dev:web-kitchen": "npm run dev --workspace=@hanin-hala/web-kitchen",
    "dev:web-cashier": "npm run dev --workspace=@hanin-hala/web-cashier",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
